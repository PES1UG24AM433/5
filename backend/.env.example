MONGODB_URI=mongodb://127.0.0.1:27017/canteen_preorder
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret

# Set NODE_ENV=production only in production deployments.
# Local development uses HTTP.
NODE_ENV=development

# Configure only when deployed behind a trusted HTTPS reverse proxy.
# Use the actual trusted proxy IP, subnet, or documented Express trust setting.
# Leave empty for local development.
TRUSTED_PROXY=
